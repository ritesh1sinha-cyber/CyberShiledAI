# Copy to .env and fill in. Never commit .env.
QWEN_BASE_URL=https://your-host/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_CA_CERT=vm06-ca.crt

# Optional but strongly recommended: raises NVD limit from 5 to 50 req / 30 s.
NVD_API_KEY=

# Hosted embeddings: the dense retrieval index and the similarity metric both call this
# endpoint (bge-small-en-v1.5, 384 dims). Ask the course coordinator for the shared
# embedding key; the certificate is vm02-ca.crt in this repo. No local model download.
EMBEDDINGS_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDINGS_MODEL=bge-small-en-v1.5
EMBEDDINGS_API_KEY=
EMBEDDINGS_CA_CERT=vm02-ca.crt

# Local Streamlit-to-FastAPI connection; do not expose either service publicly.
API_BASE_URL=http://127.0.0.1:8000
INVESTIGATION_TIMEOUT_S=600
TRACE_FILE=data/traces/investigations.jsonl

# Optional local Langfuse v2 tracing (docker/langfuse-compose.yml). Loopback hosts only;
# keys come from the local project settings page. Tracing stays off unless enabled=true.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
