.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Everything fetched from outside ships as rebuildable bulk, except the NVD CVE cache:
# app/evidence.py reads data/raw/nvd/<CVE>.json for CVSS and vendor facts, and without it
# a fresh checkout answers "no cached NVD record" and every report degrades to partial.
data/raw/*
!data/raw/nvd/
data/indexes/
data/logs/
data/backups/
# The frozen corpus ships so chunks_sha256 and every recorded number reproduce on a new
# machine; the 53 MB index derived from it is rebuilt by scripts/build_index.py.
# The two Batch 10 trace sets are the evaluation dashboards' source of record.
data/traces/*
!data/traces/batch10/
!data/traces/batch10_live_20261118/
docker/.env
docker/langfuse-data/
*.log
.mypy_cache/
.streamlit/secrets.toml
.coverage
Thumbs.db
.DS_Store
desktop.ini
~$*

# Ignore internal notes and intermediate drafts in docs/
docs/*
!docs/CyberShield_AI_Final_Technical_Report_Track_B.md
!docs/CyberShield_AI_Final_Technical_Report_Track_B.html
!docs/CyberShield_AI_Per_CVE_Audit_Dossier.md
!docs/CyberShield_AI_Per_CVE_Audit_Dossier.html
!docs/CyberShield_AI_Architecture_Flowchart.svg
!docs/CyberShield_AI_Presentation_Flowchart.html
!docs/CyberShield_AI_Architecture_FAQ.md
!docs/CyberShield_AI_End_to_End_Flowchart.svg
!docs/CyberShield_AI_End_to_End_Flowchart.mmd
!docs/CyberShield_AI_Executive_Flowchart.mmd

# Ignore loose media, course guides, and redundant datasets
*.png
*.docx
*.pdf
*.7z
*.zip
CyberShield_Golden_Dataset_100.xlsx
